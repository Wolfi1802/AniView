<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AniView.styles.css"]" />
    <link href="_content/MudBlazor/MudBlazor.min.css?v=@(MudBlazor.Metadata.Version)" rel="stylesheet" />
    <ImportMap />
    <HeadOutlet @rendermode="RenderModeWithoutPrerendering" />
</head>

<body>
    <Routes @rendermode="RenderModeWithoutPrerendering" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js?v=@(MudBlazor.Metadata.Version)"></script>
</body>

</html>

@code {
    // Without prerendering the stored language is known before the first render (no flicker from English to German).
    private static readonly IComponentRenderMode RenderModeWithoutPrerendering = new InteractiveServerRenderMode(prerender: false);
}
