@page "/simulcast"
@using AniView.Components.Shared

<PageTitle>Simulcast</PageTitle>

<MudText Typo="Typo.h4" Component="h1" GutterBottom="true">Aktueller Simulcast</MudText>
@if(_seasonString is not null)
{
    <MudText Class="mud-text-secondary mb-6">@_seasonString</MudText>
}

@if (_errorTitle is not null)
{
    <StateMessage Title="@_errorTitle" Message="@_errorMessage" Icon="@_errorIcon" OnRetry="LoadApiData" />
}
else if (!_isLoading && _items is { Count: 0 })
{
    <StateMessage Title="Keine Animes gefunden"
                  Message="API hat keine Einträge geliefert."
                  Icon="@Icons.Material.Filled.SearchOff"
                  OnRetry="LoadApiData" />
}
else
{
    <AnimeGrid Items="_items" IsLoading="_isLoading" ShowRank="true" SkeletonCount="PageSize" />
}
