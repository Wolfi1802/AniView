@page "/simulcast"
@using AniView.Components.Shared

<PageTitle>@L["Simulcast.PageTitle"]</PageTitle>

<MudText Typo="Typo.h4" Component="h1" GutterBottom="true">@L["Simulcast.Title"]</MudText>
<MudText Class="mud-text-secondary mb-6">@SubTitle</MudText>

<AnimeFilterBar @bind-Options="_options" DefaultOptions="AnimeListOptions.SimulcastDefault" ShowNextEpisodeSort="true" />

<InfiniteTable TItem="AnimeSummary"
               ViewType="InfiniteViewType.Cards"
               LoadPage="LoadPageAsync"
               ItemsPerPage="ItemsPerPage"
               ResetKey="_options"
               @bind-TotalItems="_totalItems"
               ErrorTitle="@L["Simulcast.LoadError"]"
               ErrorMessageProvider="GetErrorMessage">
    <CardTemplate Context="entry">
        <AnimeCard Anime="entry.Item" ShowDetails="true" />
    </CardTemplate>
    <EmptyContent>
        <StateMessage Title="@L["Table.Empty.Title"]"
                      Message="@L["Table.Empty.Message"]"
                      Icon="@Icons.Material.Filled.SearchOff" />
    </EmptyContent>
</InfiniteTable>
