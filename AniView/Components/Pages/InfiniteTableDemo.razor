@page "/overall-animes"
@using AniView.Components.Shared
@using AniView.Structure.API.Services

<PageTitle>Entdecken</PageTitle>

<MudText Typo="Typo.h4" Component="h1" GutterBottom="true">Entdecken</MudText>

<AnimeFilterBar @bind-Options="_options" />

<InfiniteTable TItem="AnimeSummary"
               LoadPage="LoadPopularPageAsync"
               ItemsPerPage="20"
               ResetKey="_options"
               @bind-TotalItems="_requestTotal"
               OnRowClick="OpenDetailsAsync">
    <HeaderContent>
        <AnimeTableHeader @bind-Options="_options" />
    </HeaderContent>
    <RowTemplate Context="anime">
        <AnimeTableRow Anime="anime" />
    </RowTemplate>
    <EmptyContent>
        <StateMessage Title="Keine Animes gefunden"
                      Message="Zu diesen Filtern gibt es keine Einträge."
                      Icon="@Icons.Material.Filled.SearchOff" />
    </EmptyContent>
</InfiniteTable>

@code {
    private const int ListSize = 50;

    private IReadOnlyList<AnimeSummary>? _list;
    private bool _listError;
    private int? _requestTotal;
    private int? _listTotal;

    // Sortierung und Filter. Ein neuer Wert setzt die Tabelle zurück (ResetKey) und lädt ab Seite 1 neu.
    private AnimeListOptions _options = AnimeListOptions.Default;

    [Inject]
    private IPopularAnimeService PopularAnimes { get; set; } = default!;

    [Inject]
    private IDialogService DialogService { get; set; } = default!;

    private Task OpenDetailsAsync(AnimeSummary anime) => AnimeDetailDialog.ShowAsync(DialogService, anime);

    protected override Task OnInitializedAsync() => LoadListAsync();

    private Task<PageResult<AnimeSummary>> LoadPopularPageAsync(int page, int pageSize, CancellationToken token) =>
        PopularAnimes.GetPopularPageAsync(page, pageSize, _options, token);

    private async Task LoadListAsync()
    {
        _listError = false;

        try
        {
            _list = await PopularAnimes.GetPopularAsync(ListSize);
        }
        catch (Exception)
        {
            _listError = true;
        }
    }
}
