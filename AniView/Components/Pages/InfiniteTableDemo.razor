@page "/infinite-table"
@using AniView.Components.Shared
@using AniView.Structure.API.Services

<PageTitle>Infinite Table</PageTitle>

<MudText Typo="Typo.h4" Component="h1" GutterBottom="true">Infinite Table</MudText>
<MudText Class="mud-text-secondary mb-6">Beide Quellen der Komponente: Request pro Seite und vorhandene Liste.</MudText>

<MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pt-4">
    <MudTabPanel Text="Request pro Seite">
        <InfiniteTable TItem="AnimeSummary" LoadPage="LoadPopularPageAsync" PageSize="20">
            <HeaderContent>
                <AnimeTableHeader />
            </HeaderContent>
            <RowTemplate Context="anime">
                <AnimeTableRow Anime="anime" />
            </RowTemplate>
        </InfiniteTable>
    </MudTabPanel>

    <MudTabPanel Text="Vorhandene Liste">
        @if (_listError)
        {
            <StateMessage Title="Die Liste konnte nicht geladen werden" OnRetry="LoadListAsync" />
        }
        else if (_list is not null)
        {
            <InfiniteTable TItem="AnimeSummary" Items="_list" PageSize="10">
                <HeaderContent>
                    <AnimeTableHeader />
                </HeaderContent>
                <RowTemplate Context="anime">
                    <AnimeTableRow Anime="anime" />
                </RowTemplate>
            </InfiniteTable>
        }
    </MudTabPanel>
</MudTabs>

@code {
    private const int ListSize = 50;

    private IReadOnlyList<AnimeSummary>? _list;
    private bool _listError;

    [Inject]
    private IPopularAnimeService PopularAnimes { get; set; } = default!;

    protected override Task OnInitializedAsync() => LoadListAsync();

    private Task<PageResult<AnimeSummary>> LoadPopularPageAsync(int page, int pageSize, CancellationToken token) =>
        PopularAnimes.GetPopularPageAsync(page, pageSize, token);

    private async Task LoadListAsync()
    {
        _listError = false;

        try
        {
            _list = await PopularAnimes.GetPopularAsync(ListSize);
        }
        catch (Exception)
        {
            _listError = true;
        }
    }
}
