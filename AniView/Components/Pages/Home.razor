@page "/home"
@using AniView.Components.Shared
@implements IDisposable

<PageTitle>@L["Home.PageTitle"]</PageTitle>

<WhatsNew Entries="Changelog.Entries" />

<MudText Typo="Typo.h5" Component="h2" Class="mt-8" GutterBottom="true">@L["Home.Top10.Title"]</MudText>
<MudText Class="mud-text-secondary mb-6">@L["Home.Top10.Subtitle"]</MudText>

@if (_error is not null)
{
    <StateMessage Title="@ErrorTitle" Message="@ErrorMessage" Icon="@ErrorIcon" OnRetry="LoadAsync" />
}
else if (!_isLoading && _items is { Count: 0 })
{
    <StateMessage Title="@L["Home.Empty.Title"]"
                  Message="@L["Home.Empty.Message"]"
                  Icon="@Icons.Material.Filled.SearchOff"
                  OnRetry="LoadAsync" />
}
else
{
    <AnimeGrid Items="_items" IsLoading="_isLoading" ShowRank="true" ShowPopularity="true" SkeletonCount="RankingSize" RankingLayout="true" ShowDetails="true" />
}
