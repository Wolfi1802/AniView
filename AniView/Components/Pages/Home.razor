@page "/home"
@using AniView.Components.Shared
@implements IDisposable

<PageTitle>Home</PageTitle>

<WhatsNew Entries="Changelog.Entries" />

<MudText Typo="Typo.h5" Component="h2" Class="mt-8" GutterBottom="true">Top 10 Animes</MudText>
<MudText Class="mud-text-secondary mb-6">Top Animes gemessen anhand der community</MudText>

@if (_errorTitle is not null)
{
    <StateMessage Title="@_errorTitle" Message="@_errorMessage" Icon="@_errorIcon" OnRetry="LoadAsync" />
}
else if (!_isLoading && _items is { Count: 0 })
{
    <StateMessage Title="Keine Animes gefunden"
                  Message="API hat keine Einträge geliefert."
                  Icon="@Icons.Material.Filled.SearchOff"
                  OnRetry="LoadAsync" />
}
else
{
    <AnimeGrid Items="_items" IsLoading="_isLoading" ShowRank="true" ShowPopularity="true" SkeletonCount="RankingSize" RankingLayout="true" ShowDetails="true" />
}
