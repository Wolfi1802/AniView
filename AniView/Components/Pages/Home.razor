@page "/"
@implements IDisposable

<PageTitle>AniView – Top 10</PageTitle>

<MudText Typo="Typo.h4" Component="h1" GutterBottom="true">Top 10 Animes</MudText>
<MudText Class="mud-text-secondary mb-6">Die beliebtesten Animes auf AniList, gemessen an der Anzahl der Nutzerlisten.</MudText>

@if (_errorTitle is not null)
{
    <StateMessage Title="@_errorTitle" Message="@_errorMessage" Icon="@_errorIcon" OnRetry="LoadAsync" />
}
else if (!_isLoading && _items is { Count: 0 })
{
    <StateMessage Title="Keine Animes gefunden"
                  Message="AniList hat keine Einträge geliefert."
                  Icon="@Icons.Material.Filled.SearchOff"
                  OnRetry="LoadAsync" />
}
else
{
    <AnimeGrid Items="_items" IsLoading="_isLoading" ShowRank="true" SkeletonCount="RankingSize" />
}
