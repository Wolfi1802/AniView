@using AniView.Structure.API.Exceptions
@using AniView.Structure.API.Services
@implements IDisposable

<MudDialog>
    <DialogContent>
        <div class="av-detail">
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Class="av-detail__close"
                           Size="Size.Medium"
                           AriaLabel="@L["Dialog.Close"]"
                           OnClick="Close" />

            <div class="av-detail__scroll" aria-busy="@(_isLoading ? "true" : "false")">
                @* Bild und Name sind von der Karte bereits bekannt und erscheinen sofort. *@
                <header class="av-detail__header">
                    <div class="av-detail__cover">
                        @if (!string.IsNullOrWhiteSpace(Anime.CoverUrl))
                        {
                            <img src="@Anime.CoverUrl" alt="@L.Format("Common.CoverAlt", DisplayTitle)" />
                        }
                        else
                        {
                            <div class="av-detail__cover-fallback" role="img" aria-label="@L["Common.NoCover"]">
                                <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" />
                            </div>
                        }
                    </div>

                    <div class="av-detail__headline">
                        <h2 class="av-detail__title">@DisplayTitle</h2>

                        @if (_isLoading)
                        {
                            <div class="av-detail__skeleton" aria-hidden="true">
                                <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" Width="55%" />
                                <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" Width="80%" />
                                <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" Width="70%" />
                                <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" Width="40%" />
                            </div>
                            <span class="av-detail__sr-only" role="status">@L["Dialog.Loading"]</span>
                        }
                        else if (_details is { } head)
                        {
                            @if (!string.IsNullOrWhiteSpace(head.NativeTitle) || !string.IsNullOrWhiteSpace(head.RomajiTitle))
                            {
                                <p class="av-detail__subtitle">@(head.NativeTitle ?? head.RomajiTitle)</p>
                            }

                            @if (head.Genres.Count > 0)
                            {
                                <div class="av-chips">
                                    @foreach (var genre in head.Genres)
                                    {
                                        <span class="av-chip av-chip--accent">@genre</span>
                                    }
                                </div>
                            }

                            <div class="av-facts">
                                <AnimeFact Label="@L["Detail.Format"]" Value="@L.Label("Format", head.Format)" />
                                <AnimeFact Label="@L["Detail.Status"]" Value="@L.Label("Status", head.Status)" />
                                <AnimeFact Label="@L["Detail.Season"]" Value="@SeasonText(head)" />
                                <AnimeFact Label="@L["Detail.Episodes"]" Value="@Number(head.Episodes)" />
                                <AnimeFact Label="@L["Detail.Duration"]" Value="@(head.DurationMinutes is { } minutes ? L.Format("Detail.DurationValue", minutes) : null)" />
                                <AnimeFact Label="@L["Detail.Score"]" Value="@(head.ScoreOutOfTen is { } score ? $"★ {score.ToString("0.0", L.Culture)}" : null)" />
                            </div>
                        }
                    </div>
                </header>

                @if (_isLoading)
                {
                    <div class="av-detail__skeleton av-detail__skeleton--body" aria-hidden="true">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" Width="30%" Height="28px" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" Width="100%" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" Width="96%" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" Width="90%" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" Width="60%" />

                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" Width="25%" Height="28px" Class="mt-6" />
                        <div class="av-detail__skeleton-grid">
                            @for (var i = 0; i < 8; i++)
                            {
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Pulse" Width="100%" Height="44px" />
                            }
                        </div>

                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Pulse" Width="25%" Height="28px" Class="mt-6" />
                        <div class="av-detail__skeleton-row">
                            @for (var i = 0; i < 5; i++)
                            {
                                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Animation="Animation.Pulse" Width="100%" Height="96px" />
                            }
                        </div>
                    </div>
                }
                else if (_error is not null)
                {
                    <StateMessage Title="@L["Dialog.Error.Title"]"
                                  Message="@ErrorText"
                                  OnRetry="LoadAsync" />
                }
                else if (_details is { } d)
                {
                    @if (!string.IsNullOrWhiteSpace(d.Description))
                    {
                        <AnimeDetailSection Title="@L["Section.Description"]">
                            <p class="av-detail__description">@d.Description</p>
                        </AnimeDetailSection>
                    }

                    <AnimeDetailSection Title="@L["Section.Details"]">
                        <div class="av-facts av-facts--wide">
                            <AnimeFact Label="@L["Detail.EnglishTitle"]" Value="@d.EnglishTitle" />
                            <AnimeFact Label="@L["Detail.RomajiTitle"]" Value="@d.RomajiTitle" />
                            <AnimeFact Label="@L["Detail.NativeTitle"]" Value="@d.NativeTitle" />
                            <AnimeFact Label="@L["Detail.Synonyms"]" Value="@(Joined(", ", d.Synonyms))" />
                            <AnimeFact Label="@L["Detail.Start"]" Value="@DateText(d.StartDate)" />
                            <AnimeFact Label="@L["Detail.End"]" Value="@DateText(d.EndDate)" />
                            <AnimeFact Label="@L["Detail.Source"]" Value="@L.Label("Source", d.Source)" />
                            <AnimeFact Label="@L["Detail.Country"]" Value="@L.Label("Country", d.CountryOfOrigin)" />
                            <AnimeFact Label="@L["Detail.Licensed"]" Value="@(d.IsLicensed is { } licensed ? (licensed ? L["Common.Yes"] : L["Common.No"]) : null)" />
                            <AnimeFact Label="@L["Detail.Hashtag"]" Value="@d.Hashtag" />
                            <AnimeFact Label="@L["Detail.Studios"]" Value="@StudioText(d)" />
                            <AnimeFact Label="@L["Detail.AverageScore"]" Value="@(d.AverageScore is { } average ? $"{average} / 100" : null)" />
                            <AnimeFact Label="@L["Detail.MeanScore"]" Value="@(d.MeanScore is { } mean ? $"{mean} / 100" : null)" />
                            <AnimeFact Label="@L["Detail.Popularity"]" Value="@Number(d.Popularity)" />
                            <AnimeFact Label="@L["Detail.Favourites"]" Value="@Number(d.Favourites)" />
                            <AnimeFact Label="@L["Detail.Trending"]" Value="@Number(d.Trending)" />
                            <AnimeFact Label="@L["Detail.MalId"]" Value="@(d.MalId?.ToString(L.Culture))" />
                            <AnimeFact Label="@L["Detail.Updated"]" Value="@(d.UpdatedAt is { } updated ? updated.ToLocalTime().ToString("d", L.Culture) : null)" />
                        </div>

                        @if (SafeUrl(d.SiteUrl) is { } siteUrl)
                        {
                            <p class="av-detail__link-row">
                                <a class="av-chip av-chip--link" href="@siteUrl" target="_blank" rel="noopener noreferrer">@L["Detail.ViewOnAniList"]</a>
                            </p>
                        }
                    </AnimeDetailSection>

                    @if (d.NextEpisode is { } next)
                    {
                        <AnimeDetailSection Title="@L["Section.NextEpisode"]">
                            <p class="av-detail__text">
                                @NextEpisodeText(next)
                            </p>
                            @if (d.UpcomingEpisodes.Count > 1)
                            {
                                <ul class="av-list">
                                    @foreach (var upcoming in d.UpcomingEpisodes.Where(e => e.Episode != next.Episode))
                                    {
                                        <li>
                                            @UpcomingEpisodeText(upcoming)
                                        </li>
                                    }
                                </ul>
                            }
                        </AnimeDetailSection>
                    }

                    @if (d.Trailer is { } trailer)
                    {
                        <AnimeDetailSection Title="@L["Section.Trailer"]">
                            @if (SafeUrl(trailer.Url) is { } trailerUrl)
                            {
                                <a class="av-trailer" href="@trailerUrl" target="_blank" rel="noopener noreferrer">
                                    @if (SafeUrl(trailer.ThumbnailUrl) is { } thumbnail)
                                    {
                                        <img src="@thumbnail" alt="@L["Detail.Trailer.Thumbnail"]" loading="lazy" />
                                    }
                                    <span class="av-chip av-chip--link">@L.Format("Detail.Trailer.Watch", trailer.Site)</span>
                                </a>
                            }
                            else
                            {
                                <p class="av-detail__text">@L.Format("Detail.Trailer.Plain", trailer.Site, trailer.Id)</p>
                            }
                        </AnimeDetailSection>
                    }

                    @if (d.Rankings.Count > 0)
                    {
                        <AnimeDetailSection Title="@L["Section.Rankings"]">
                            <ul class="av-list">
                                @foreach (var ranking in d.Rankings)
                                {
                                    <li>
                                        <strong>#@ranking.Rank</strong>
                                        @RankingText(ranking)
                                    </li>
                                }
                            </ul>
                        </AnimeDetailSection>
                    }

                    @if (d.Tags.Count > 0)
                    {
                        var visibleTags = d.Tags.Where(t => !t.IsSpoiler).ToList();
                        var spoilerTags = d.Tags.Where(t => t.IsSpoiler).ToList();

                        <AnimeDetailSection Title="@L["Section.Tags"]">
                            <div class="av-chips">
                                @foreach (var tag in visibleTags)
                                {
                                    <span class="av-chip" title="@tag.Description">@TagText(tag)</span>
                                }
                            </div>

                            @if (spoilerTags.Count > 0)
                            {
                                <details class="av-spoiler">
                                    <summary>@L.Format("Detail.SpoilerTags", spoilerTags.Count)</summary>
                                    <div class="av-chips">
                                        @foreach (var tag in spoilerTags)
                                        {
                                            <span class="av-chip" title="@tag.Description">@TagText(tag)</span>
                                        }
                                    </div>
                                </details>
                            }
                        </AnimeDetailSection>
                    }

                    @if (d.Characters.Count > 0)
                    {
                        <AnimeDetailSection Title="@L["Section.Characters"]">
                            <div class="av-people">
                                @foreach (var person in d.Characters)
                                {
                                    <div class="av-person">
                                        @if (!string.IsNullOrWhiteSpace(person.ImageUrl))
                                        {
                                            <img src="@person.ImageUrl" alt="@person.Name" loading="lazy" />
                                        }
                                        <div class="av-person__text">
                                            <span class="av-person__name">@person.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(person.NativeName))
                                            {
                                                <span class="av-person__role">@person.NativeName</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(person.Role))
                                            {
                                                <span class="av-person__role">@L.Translate("Role", person.Role)</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </AnimeDetailSection>
                    }

                    @if (d.Staff.Count > 0)
                    {
                        <AnimeDetailSection Title="@L["Section.Staff"]">
                            <div class="av-people">
                                @foreach (var person in d.Staff)
                                {
                                    <div class="av-person">
                                        @if (!string.IsNullOrWhiteSpace(person.ImageUrl))
                                        {
                                            <img src="@person.ImageUrl" alt="@person.Name" loading="lazy" />
                                        }
                                        <div class="av-person__text">
                                            <span class="av-person__name">@person.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(person.NativeName))
                                            {
                                                <span class="av-person__role">@person.NativeName</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(person.Role))
                                            {
                                                <span class="av-person__role">@L.Translate("Role", person.Role)</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </AnimeDetailSection>
                    }

                    @if (d.ExternalLinks.Count > 0)
                    {
                        <AnimeDetailSection Title="@L["Section.Links"]">
                            <div class="av-chips">
                                @foreach (var link in d.ExternalLinks)
                                {
                                    @if (SafeUrl(link.Url) is { } linkUrl)
                                    {
                                        <a class="av-chip av-chip--link" href="@linkUrl" target="_blank" rel="noopener noreferrer"
                                           title="@link.Notes">
                                            @LinkText(link)
                                        </a>
                                    }
                                }
                            </div>
                        </AnimeDetailSection>
                    }

                    @if (d.Reviews.Count > 0)
                    {
                        <AnimeDetailSection Title="@L["Section.Reviews"]">
                            <div class="av-reviews">
                                @foreach (var review in d.Reviews)
                                {
                                    <article class="av-review">
                                        <p class="av-review__meta">
                                            <strong>@(review.UserName ?? L["Detail.Review.Unknown"])</strong>@ReviewMeta(review)
                                        </p>
                                        <p class="av-detail__text">@review.Summary</p>
                                    </article>
                                }
                            </div>
                        </AnimeDetailSection>
                    }

                    @if (d.Trends.Count > 0)
                    {
                        <AnimeDetailSection Title="@L["Section.Trends"]">
                            <div class="av-table-wrap">
                                <table class="av-table">
                                    <thead>
                                        <tr>
                                            <th>@L["Trend.Date"]</th>
                                            <th>@L["Trend.Trend"]</th>
                                            <th>@L["Trend.Popularity"]</th>
                                            <th>@L["Trend.AverageScore"]</th>
                                            <th>@L["Trend.Watching"]</th>
                                            <th>@L["Trend.Episode"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var trend in d.Trends)
                                        {
                                            <tr>
                                                <td>@(trend.Date?.ToLocalTime().ToString("d", L.Culture) ?? "-")</td>
                                                <td>@(Number(trend.Trending) ?? "-")</td>
                                                <td>@(Number(trend.Popularity) ?? "-")</td>
                                                <td>@(trend.AverageScore?.ToString(L.Culture) ?? "-")</td>
                                                <td>@(Number(trend.InProgress) ?? "-")</td>
                                                <td>@(trend.Episode?.ToString(L.Culture) ?? "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </AnimeDetailSection>
                    }
                }
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    private readonly CancellationTokenSource _cts = new();

    private AnimeDetails? _details;
    private bool _isLoading = true;
    private Exception? _error;

    private string DisplayTitle => L.DisplayTitle(Anime.Title);

    // Built when rendering (not when the error happens), so the text follows a language change.
    private string ErrorText => _error switch
    {
        ApiRateLimitException rateLimit => L.RateLimitMessage(rateLimit.RetryAfter),
        ApiException => L["Error.Connection"],
        _ => L["Error.Unexpected"]
    };

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>
    /// Die bereits bekannten Angaben der Karte. Bild und Name werden sofort angezeigt, alles Weitere wird nachgeladen.
    /// </summary>
    [Parameter, EditorRequired]
    public AnimeSummary Anime { get; set; } = default!;

    [Inject]
    private IAnimeDetailService DetailService { get; set; } = default!;

    [Inject]
    private ILogger<AnimeDetailDialog> Logger { get; set; } = default!;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _details = await DetailService.GetDetailsAsync(Anime.Id, _cts.Token);
        }
        catch (OperationCanceledException) when (_cts.IsCancellationRequested)
        {
            // Der Dialog wurde geschlossen, das Ergebnis wird nicht mehr gebraucht.
            return;
        }
        catch (ApiRateLimitException ex)
        {
            _error = ex;
        }
        catch (ApiException ex)
        {
            Logger.LogWarning(ex, "Details zu Anime {AnimeId} konnten nicht geladen werden.", Anime.Id);
            _error = ex;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unerwarteter Fehler beim Laden der Details zu Anime {AnimeId}.", Anime.Id);
            _error = ex;
        }
        finally
        {
            if (!_cts.IsCancellationRequested)
            {
                _isLoading = false;
            }
        }
    }

    /// <summary>
    /// Öffnet den Detail-Dialog zu einem Anime. Die Details lädt der Dialog selbst nach, sobald er offen ist.
    /// </summary>
    public static Task<IDialogReference> ShowAsync(IDialogService dialogService, AnimeSummary anime)
    {
        var parameters = new DialogParameters<AnimeDetailDialog>
        {
            { dialog => dialog.Anime, anime }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            NoHeader = true,
            CloseOnEscapeKey = true,
            BackdropClick = true
        };

        return dialogService.ShowAsync<AnimeDetailDialog>(anime.Title, parameters, options);
    }

    private void Close() => MudDialog.Close();

    private string? Number(int? value) => value?.ToString("N0", L.Culture);

    private string? DateText(AnimePartialDate? date) => date is null ? null : L.FormatPartialDate(date);

    private string? SeasonText(AnimeDetails details)
    {
        var label = L.Label("Season", details.Season);

        return (label, details.SeasonYear) switch
        {
            (not null, not null) => $"{label} {details.SeasonYear}",
            (not null, null) => label,
            (null, not null) => details.SeasonYear.ToString(),
            _ => null
        };
    }

    /// <summary>
    /// Externe Adressen stammen aus der API und werden nur als Link ausgegeben, wenn sie mit http oder https beginnen.
    /// </summary>
    private static string? SafeUrl(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri)
        && (uri.Scheme == Uri.UriSchemeHttps || uri.Scheme == Uri.UriSchemeHttp)
            ? uri.AbsoluteUri
            : null;

    private static string? Joined(string separator, params IEnumerable<string?> parts)
    {
        var text = string.Join(separator, parts.Where(part => !string.IsNullOrWhiteSpace(part)));

        return text.Length > 0 ? text : null;
    }

    private string? StudioText(AnimeDetails details) =>
        Joined(", ", details.Studios.Select(studio => studio.IsMain ? L.Format("Detail.MainStudio", studio.Name) : studio.Name));

    private string NextEpisodeText(AnimeAiring next) =>
        next.AiringAt is { } at
            ? L.Format("Detail.NextEpisode.At", next.Episode, L.FormatDate(at, "Format.WeekdayDateTime"))
            : L.Format("Detail.NextEpisode.NoDate", next.Episode);

    private string UpcomingEpisodeText(AnimeAiring upcoming) =>
        upcoming.AiringAt is { } at
            ? L.Format("Detail.Upcoming.At", upcoming.Episode, L.FormatDate(at, "Format.WeekdayDateCompact"))
            : L.Format("Detail.Upcoming.NoDate", upcoming.Episode);

    private string RankingText(AnimeRanking ranking)
    {
        var context = string.IsNullOrWhiteSpace(ranking.Context) ? string.Empty : $" – {ranking.Context}";

        return $"{L.Label("RankingType", ranking.Type)}{context}{RankingPeriod(ranking)}";
    }

    private static string TagText(AnimeTag tag) =>
        tag.Rank is { } rank ? $"{tag.Name} · {rank} %" : tag.Name;

    private static string LinkText(AnimeExternalLink link) =>
        string.IsNullOrWhiteSpace(link.Language) ? link.Site : $"{link.Site} ({link.Language})";

    private string ReviewMeta(AnimeReview review)
    {
        var parts = new List<string>();

        if (review.Score is { } score)
        {
            parts.Add($"★ {score} / 100");
        }

        if (review.CreatedAt is { } created)
        {
            parts.Add(created.ToLocalTime().ToString("d", L.Culture));
        }

        if (review is { Rating: { } helpful, RatingAmount: { } votes })
        {
            parts.Add(L.Format("Detail.Review.Helpful", helpful, votes));
        }

        return parts.Count > 0 ? " · " + string.Join(" · ", parts) : string.Empty;
    }

    private string RankingPeriod(AnimeRanking ranking)
    {
        if (ranking.AllTime)
        {
            return $" ({L["Ranking.AllTime"]})";
        }

        var period = string.Join(' ', new[] { L.Label("Season", ranking.Season), ranking.Year?.ToString() }.Where(v => !string.IsNullOrWhiteSpace(v)));

        return period.Length > 0 ? $" ({period})" : string.Empty;
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
