@using AniView.Structure.API
@using AniView.Structure.API.Mapping
@using AniView.Structure.API.Services
@implements IAsyncDisposable

@* Filter und Sortierung einer Anime-Liste. Die Leiste bleibt beim Scrollen unterhalb der Kopfzeile sichtbar (siehe AnimeFilterBar.razor.css). *@
<div @ref="_bar" class="av-filter-bar" role="search" aria-label="Filter und Sortierung">
    <div class="av-filter-bar__field av-filter-bar__field--search">
        <MudTextField T="string"
                      Value="@Options.Search"
                      ValueChanged="OnSearchChangedAsync"
                      Label="Titel suchen"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Immediate="true"
                      DebounceInterval="400"
                      MaxLength="100"
                      Clearable="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" />
    </div>

    <div class="av-filter-bar__field">
        <MudSelect T="AnimeFormat?"
                   Value="@Options.Format"
                   ValueChanged="OnFormatChangedAsync"
                   Label="Format"
                   Placeholder="Alle Formate"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="true">
            @foreach (var format in Enum.GetValues<AnimeFormat>())
            {
                <MudSelectItem T="AnimeFormat?" Value="@((AnimeFormat?)format)">@GetFormatLabel(format)</MudSelectItem>
            }
        </MudSelect>
    </div>

    <div class="av-filter-bar__field">
        <MudSelect T="string"
                   Value="@Options.StreamingSite"
                   ValueChanged="OnStreamingSiteChangedAsync"
                   Label="Streaming-Dienst"
                   Placeholder="Alle Dienste"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="true">
            @foreach (var site in _streamingSites)
            {
                <MudSelectItem T="string" Value="@site">@site</MudSelectItem>
            }
        </MudSelect>
    </div>

    <div class="av-filter-bar__field av-filter-bar__field--sort">
        <MudSelect T="AnimeSortField"
                   Value="@Options.SortField"
                   ValueChanged="OnSortFieldChangedAsync"
                   Label="Sortieren nach"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense">
            @foreach (var field in Enum.GetValues<AnimeSortField>().Where(IsSortFieldOffered))
            {
                <MudSelectItem T="AnimeSortField" Value="@field">@GetSortFieldLabel(field)</MudSelectItem>
            }
        </MudSelect>

        <MudIconButton Icon="@(Options.Descending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)"
                       Title="@DirectionTitle"
                       AriaLabel="@DirectionTitle"
                       OnClick="OnDirectionToggledAsync" />
    </div>

    @if (Options != DefaultOptions)
    {
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.FilterAltOff"
                   OnClick="OnResetAsync">
            Zurücksetzen
        </MudButton>
    }
</div>

@code {
    private const string ModulePath = "./Components/Shared/AnimeFilterBar.razor.js";

    private ElementReference _bar;
    private IJSObjectReference? _module;
    private IReadOnlyList<string> _streamingSites = [];

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    [Inject]
    private IStreamingSiteService StreamingSites { get; set; } = default!;

    /// <summary>
    /// Aktuelle Sortierung und Filter. Mit <c>@bind-Options</c> bindbar.
    /// </summary>
    [Parameter, EditorRequired]
    public AnimeListOptions Options { get; set; } = AnimeListOptions.Default;

    [Parameter]
    public EventCallback<AnimeListOptions> OptionsChanged { get; set; }

    /// <summary>
    /// Standard der jeweiligen Liste. Darauf setzt "Zurücksetzen" zurück, und die Schaltfläche erscheint nur bei Abweichung.
    /// </summary>
    [Parameter]
    public AnimeListOptions DefaultOptions { get; set; } = AnimeListOptions.Default;

    /// <summary>
    /// Bietet die Sortierung nach dem Zeitpunkt der nächsten Folge an. Sinnvoll nur für laufende Serien (Simulcast).
    /// </summary>
    [Parameter]
    public bool ShowNextEpisodeSort { get; set; }

    private bool IsSortFieldOffered(AnimeSortField field) =>
        field != AnimeSortField.NextEpisode || ShowNextEpisodeSort || Options.SortField == AnimeSortField.NextEpisode;

    private string DirectionTitle => Options.Descending
        ? "Absteigend sortiert, zum Umkehren klicken"
        : "Aufsteigend sortiert, zum Umkehren klicken";

    /// <summary>
    /// Deutsche Bezeichnung einer Sortierspalte, einheitlich für Leiste und Tabellenkopf.
    /// </summary>
    internal static string GetSortFieldLabel(AnimeSortField field) => field switch
    {
        AnimeSortField.Popularity => "Beliebtheit",
        AnimeSortField.Score => "Rating",
        AnimeSortField.Title => "Titel",
        AnimeSortField.Episodes => "Episoden",
        AnimeSortField.NextEpisode => "Nächste Folge",
        AnimeSortField.Format => "Format",
        _ => field.ToString()
    };

    private static string GetFormatLabel(AnimeFormat format) =>
        AnimeSummaryMapper.GetFormatLabel(AnimeListOptionsMapping.ToApiFormat(format)) ?? format.ToString();

    protected override async Task OnInitializedAsync()
    {
        _streamingSites = await StreamingSites.GetStreamingSitesAsync();
        EnsureSelectedSiteListed();
    }

    // Ein aktiver Filter muss auswählbar bleiben, auch wenn der Dienst nicht in der geladenen Liste steht.
    private void EnsureSelectedSiteListed()
    {
        var selected = Options.StreamingSite;
        if (selected is not null && !_streamingSites.Contains(selected, StringComparer.OrdinalIgnoreCase))
        {
            _streamingSites = [.. _streamingSites, selected];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Höhe der Leiste bereitstellen, damit der Tabellenkopf darunter einrastet.
        _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        await _module.InvokeVoidAsync("observe", _bar);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        try
        {
            await _module.InvokeVoidAsync("dispose", _bar);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // Die Verbindung ist bereits getrennt, es gibt nichts mehr aufzuräumen.
        }
    }

    private Task OnSearchChangedAsync(string? search) => OptionsChanged.InvokeAsync(Options.WithSearch(search));

    private Task OnFormatChangedAsync(AnimeFormat? format) => OptionsChanged.InvokeAsync(Options with { Format = format });

    private Task OnStreamingSiteChangedAsync(string? site) => OptionsChanged.InvokeAsync(Options with { StreamingSite = site });

    private Task OnSortFieldChangedAsync(AnimeSortField field) => OptionsChanged.InvokeAsync(Options.WithSortField(field));

    private Task OnDirectionToggledAsync() => OptionsChanged.InvokeAsync(Options with { Descending = !Options.Descending });

    private Task OnResetAsync() => OptionsChanged.InvokeAsync(DefaultOptions);
}
