@implements IDisposable
@inject IDialogService DialogService

<article class="av-card">
    <div class="av-cover-wrap">
        @if (ShowDetails)
        {
            <button type="button"
                    class="av-cover-btn"
                    title="@L["Card.MoreInfo"]"
                    aria-label="@L.Format("Card.MoreInfoAbout", DisplayTitle)"
                    aria-haspopup="dialog"
                    @onclick="OpenDetailsAsync">
                @CoverContent
            </button>
        }
        else
        {
            @CoverContent
        }

        <h3 class="av-title" title="@DisplayTitle"><span class="av-title__text">@DisplayTitle</span></h3>
    </div>

    <div class="av-content">
        <div class="av-main">
            <div class="av-head">
                <div class="av-airing">
                    <span class="av-airing__label">@AiringLabel</span>
                    <span class="av-airing__value" title="@AiringDateText">@AiringValue</span>
                    @if (!string.IsNullOrWhiteSpace(Anime.Format))
                    {
                        <span class="av-airing__format">@L.Label("Format", Anime.Format)</span>
                    }
                </div>

                <ul class="av-stats">
                    <li class="av-stat @ScoreCssClass" title="@L["Card.AverageScore"]">
                        <MudIcon Icon="@Icons.Material.Filled.SentimentSatisfiedAlt" Size="Size.Small" />
                        <span>@(Anime.AverageScore is > 0 ? $"{Anime.AverageScore}%" : "-")</span>
                    </li>
                    @if (Rank is { } rank)
                    {
                        <li class="av-stat av-stat--rank" title="@L.Format("Card.Rank", rank)">
                            <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Small" />
                            <span>#@rank</span>
                        </li>
                    }
                    @if (ShowPopularity)
                    {
                        <li class="av-stat av-stat--popularity" title="@L["Card.Popularity"]">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
                            <span>@(Anime.Popularity is { } popularity ? popularity.ToString("N0", L.Culture) : "-")</span>
                        </li>
                    }
                </ul>
            </div>

            @if (!string.IsNullOrWhiteSpace(Anime.Description))
            {
                <p class="av-description">@Anime.Description</p>
            }
        </div>

        @if (Anime.Genres.Count > 0)
        {
            <div class="av-footer">
                <ul class="av-genres">
                    @foreach (var genre in Anime.Genres.Take(MaxGenres))
                    {
                        <li class="av-genre">@genre</li>
                    }
                </ul>
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public AnimeSummary Anime { get; set; } = default!;

    [Parameter]
    public int? Rank { get; set; }

    /// <summary>
    /// Zeigt die Beliebtheit (Anzahl der Nutzer, die den Anime in ihrer Liste haben) auf der Karte.
    /// </summary>
    [Parameter]
    public bool ShowPopularity { get; set; }

    /// <summary>
    /// Zeigt oben rechts im Bild ein Info-Symbol, das den Detail-Dialog mit allen Informationen zum Anime öffnet.
    /// </summary>
    [Parameter]
    public bool ShowDetails { get; set; }

    private const int MaxGenres = 3;

    private string DisplayTitle => L.DisplayTitle(Anime.Title);

    private Task OpenDetailsAsync() => AnimeDetailDialog.ShowAsync(DialogService, Anime);

    /// <summary>
    /// Cover beziehungsweise Platzhalter. Wird je nach <see cref="ShowDetails"/> mit oder ohne Klickfläche ausgegeben.
    /// Als Razor-Vorlage geschrieben, damit die Elemente das Scope-Attribut der Komponenten-CSS erhalten
    /// (per RenderTreeBuilder erzeugte Elemente bekämen es nicht, das Cover würde dann unskaliert angezeigt).
    /// </summary>
    private RenderFragment CoverContent => @<text>
        @if (!string.IsNullOrWhiteSpace(Anime.CoverUrl))
        {
            <img class="av-cover" src="@Anime.CoverUrl" alt="@L.Format("Common.CoverAlt", DisplayTitle)" loading="lazy" />
        }
        else
        {
            <div class="av-cover-fallback" role="img" aria-label="@L["Common.NoCover"]">
                <MudIcon Icon="@Icons.Material.Filled.ImageNotSupported" Size="Size.Large" />
            </div>
        }
    </text>;

    private string ScoreCssClass => Anime.AverageScore switch
    {
        >= 70 => "av-stat--good",
        >= 50 => "av-stat--mid",
        > 0 => "av-stat--low",
        _ => "av-stat--none"
    };

    /// <summary>
    /// Kopfzeile der Erscheinungsangabe, zum Beispiel "Folge 4 von 12 erscheint in" (je nach Sprache).
    /// </summary>
    private string AiringLabel
    {
        get
        {
            if (Anime.IsFinished)
            {
                return L["Card.Finished"];
            }

            if (Anime.NextEpisodeNumber is not { } number)
            {
                return L["Card.NextEpisode"];
            }

            return Anime.Episodes is { } total && total >= number
                ? L.Format("Card.EpisodeOfTotal", number, total)
                : L.Format("Card.EpisodeAirs", number);
        }
    }

    private string AiringValue
    {
        get
        {
            if (Anime.IsFinished)
            {
                return Anime.Episodes is { } episodes
                    ? L.Plural("Card.Episodes", episodes)
                    : L["Card.AllEpisodes"];
            }

            if (Anime.NextEpisodeAiringAt is not { } airingAt)
            {
                return L["Card.NoDate"];
            }

            var remaining = airingAt - _now;

            if (remaining <= TimeSpan.Zero)
            {
                return L["Card.AlreadyAired"];
            }

            return FormatRemaining(remaining);
        }
    }

    /// <summary>
    /// Genauer Erscheinungstermin als Tooltip des Countdowns.
    /// </summary>
    private string? AiringDateText => !Anime.IsFinished && Anime.NextEpisodeAiringAt is { } airingAt
        ? L.FormatDate(airingAt, "Format.WeekdayDate")
        : null;

    private string FormatRemaining(TimeSpan remaining)
    {
        var days = (int)remaining.TotalDays;

        if (days > 0)
        {
            return $"{L.Plural("Time.Day", days)}, {L.Plural("Time.Hour", remaining.Hours)}";
        }

        if (remaining.Hours > 0)
        {
            return $"{L.Plural("Time.Hour", remaining.Hours)}, {L.Plural("Time.Minute", remaining.Minutes)}";
        }

        return L.Plural("Time.Minute", remaining.Minutes);
    }

    private DateTimeOffset _now = DateTimeOffset.Now;
    private readonly CancellationTokenSource _timerCts = new();
    protected override void OnInitialized()
    {
        _ = UpdateCountdownAsync(_timerCts.Token);
    }
    private async Task UpdateCountdownAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    _now = DateTimeOffset.Now;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Timer wurde beim Verlassen der Komponente beendet.
        }
    }

    public void Dispose()
    {
        _timerCts.Cancel();
        _timerCts.Dispose();
    }
}
