@implements IDisposable
@inject IDialogService DialogService

<article class="av-card">
    <div class="av-cover-wrap">
        @if (ShowDetails)
        {
            <button type="button"
                    class="av-cover-btn"
                    title="Weitere Informationen"
                    aria-label="Weitere Informationen zu @Anime.Title"
                    aria-haspopup="dialog"
                    @onclick="OpenDetailsAsync">
                @CoverContent
            </button>
        }
        else
        {
            @CoverContent
        }

        <h3 class="av-title" title="@Anime.Title"><span class="av-title__text">@Anime.Title</span></h3>
    </div>

    <div class="av-content">
        <div class="av-main">
            <div class="av-head">
                <div class="av-airing">
                    <span class="av-airing__label">@AiringLabel</span>
                    <span class="av-airing__value" title="@AiringDateText">@AiringValue</span>
                    @if (!string.IsNullOrWhiteSpace(Anime.Format))
                    {
                        <span class="av-airing__format">@Anime.Format</span>
                    }
                </div>

                <ul class="av-stats">
                    <li class="av-stat @ScoreCssClass" title="Durchschnittliche Bewertung">
                        <MudIcon Icon="@Icons.Material.Filled.SentimentSatisfiedAlt" Size="Size.Small" />
                        <span>@(Anime.AverageScore is > 0 ? $"{Anime.AverageScore}%" : "-")</span>
                    </li>
                    @if (Rank is { } rank)
                    {
                        <li class="av-stat av-stat--rank" title="Platz @rank">
                            <MudIcon Icon="@Icons.Material.Filled.Favorite" Size="Size.Small" />
                            <span>#@rank</span>
                        </li>
                    }
                    @if (ShowPopularity)
                    {
                        <li class="av-stat av-stat--popularity" title="Nutzer, die den Anime in ihrer Liste haben">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" />
                            <span>@(Anime.Popularity is { } popularity ? popularity.ToString("N0", De) : "-")</span>
                        </li>
                    }
                </ul>
            </div>

            @if (!string.IsNullOrWhiteSpace(Anime.Description))
            {
                <p class="av-description">@Anime.Description</p>
            }
        </div>

        @if (Anime.Genres.Count > 0)
        {
            <div class="av-footer">
                <ul class="av-genres">
                    @foreach (var genre in Anime.Genres.Take(MaxGenres))
                    {
                        <li class="av-genre">@genre</li>
                    }
                </ul>
            </div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public AnimeSummary Anime { get; set; } = default!;

    [Parameter]
    public int? Rank { get; set; }

    /// <summary>
    /// Zeigt die Beliebtheit (Anzahl der Nutzer, die den Anime in ihrer Liste haben) auf der Karte.
    /// </summary>
    [Parameter]
    public bool ShowPopularity { get; set; }

    /// <summary>
    /// Zeigt oben rechts im Bild ein Info-Symbol, das den Detail-Dialog mit allen Informationen zum Anime öffnet.
    /// </summary>
    [Parameter]
    public bool ShowDetails { get; set; }

    private const int MaxGenres = 3;

    private static readonly CultureInfo De = CultureInfo.GetCultureInfo("de-DE");

    private Task OpenDetailsAsync() => AnimeDetailDialog.ShowAsync(DialogService, Anime);

    /// <summary>
    /// Cover beziehungsweise Platzhalter. Wird je nach <see cref="ShowDetails"/> mit oder ohne Klickfläche ausgegeben.
    /// </summary>
    private RenderFragment CoverContent => builder =>
    {
        if (!string.IsNullOrWhiteSpace(Anime.CoverUrl))
        {
            builder.OpenElement(0, "img");
            builder.AddAttribute(1, "class", "av-cover");
            builder.AddAttribute(2, "src", Anime.CoverUrl);
            builder.AddAttribute(3, "alt", $"Cover von {Anime.Title}");
            builder.AddAttribute(4, "loading", "lazy");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(5, "div");
            builder.AddAttribute(6, "class", "av-cover-fallback");
            builder.AddAttribute(7, "role", "img");
            builder.AddAttribute(8, "aria-label", "Kein Cover verfügbar");
            builder.OpenComponent<MudIcon>(9);
            builder.AddComponentParameter(10, nameof(MudIcon.Icon), Icons.Material.Filled.ImageNotSupported);
            builder.AddComponentParameter(11, nameof(MudIcon.Size), Size.Large);
            builder.CloseComponent();
            builder.CloseElement();
        }
    };

    private string ScoreCssClass => Anime.AverageScore switch
    {
        >= 70 => "av-stat--good",
        >= 50 => "av-stat--mid",
        > 0 => "av-stat--low",
        _ => "av-stat--none"
    };

    /// <summary>
    /// Kopfzeile der Erscheinungsangabe, zum Beispiel "Folge 4 von 12 erscheint in".
    /// </summary>
    private string AiringLabel
    {
        get
        {
            if (Anime.IsFinished)
            {
                return "Beendet";
            }

            if (Anime.NextEpisodeNumber is not { } number)
            {
                return "Nächste Folge";
            }

            return Anime.Episodes is { } total && total >= number
                ? $"Folge {number} von {total} erscheint in"
                : $"Folge {number} erscheint in";
        }
    }

    private string AiringValue
    {
        get
        {
            if (Anime.IsFinished)
            {
                return Anime.Episodes is { } episodes
                    ? $"{episodes} {(episodes == 1 ? "Folge" : "Folgen")}"
                    : "Alle Folgen erschienen";
            }

            if (Anime.NextEpisodeAiringAt is not { } airingAt)
            {
                return "Noch kein Termin";
            }

            var remaining = airingAt - _now;

            if (remaining <= TimeSpan.Zero)
            {
                return "Bereits erschienen";
            }

            return FormatRemaining(remaining);
        }
    }

    /// <summary>
    /// Genauer Erscheinungstermin als Tooltip des Countdowns.
    /// </summary>
    private string? AiringDateText => !Anime.IsFinished && Anime.NextEpisodeAiringAt is { } airingAt
        ? airingAt.ToLocalTime().ToString("dddd, 'den' dd.MM.yyyy", De)
        : null;

    private static string FormatRemaining(TimeSpan remaining)
    {
        var days = (int)remaining.TotalDays;

        if (days > 0)
        {
            return $"{days} {(days == 1 ? "Tag" : "Tage")}, {remaining.Hours} {(remaining.Hours == 1 ? "Stunde" : "Stunden")}";
        }

        if (remaining.Hours > 0)
        {
            return $"{remaining.Hours} {(remaining.Hours == 1 ? "Stunde" : "Stunden")}, {remaining.Minutes} {(remaining.Minutes == 1 ? "Minute" : "Minuten")}";
        }

        return $"{remaining.Minutes} {(remaining.Minutes == 1 ? "Minute" : "Minuten")}";
    }

    private DateTimeOffset _now = DateTimeOffset.Now;
    private readonly CancellationTokenSource _timerCts = new();
    protected override void OnInitialized()
    {
        _ = UpdateCountdownAsync(_timerCts.Token);
    }
    private async Task UpdateCountdownAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(() =>
                {
                    _now = DateTimeOffset.Now;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Timer wurde beim Verlassen der Komponente beendet.
        }
    }

    public void Dispose()
    {
        _timerCts.Cancel();
        _timerCts.Dispose();
    }
}
