@typeparam TItem
@implements IAsyncDisposable

<div class="av-infinite-table @(ViewType == InfiniteViewType.Table ? "av-infinite-table--table" : null)" aria-busy="@(_isLoading ? "true" : "false")">
    @if (_error is not null && _rows.Count == 0)
    {
        <StateMessage Title="@(ErrorTitle ?? L["Infinite.ErrorTitle"])" Message="@ErrorText" OnRetry="RetryAsync" />
    }
    else if (IsEmpty)
    {
        @if (EmptyContent is not null)
        {
            @EmptyContent
        }
        else
        {
            <StateMessage Title="@L["Infinite.EmptyTitle"]"
                          Icon="@Icons.Material.Filled.SearchOff" />
        }
    }
    else if (_rows.Count > 0)
    {
        @switch (ViewType)
        {
            case InfiniteViewType.Cards:
                <div class="av-infinite-cards">
                    @for (var i = 0; i < _rows.Count; i++)
                    {
                        @CardTemplate?.Invoke(new InfiniteEntry<TItem>(_rows[i], i))
                    }
                </div>
                break;

            default:
                <MudSimpleTable Hover="true" Dense="@Dense" Elevation="0" Outlined="true">
                    <thead>
                        <tr>@HeaderContent</tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _rows)
                        {
                            <tr class="@(OnRowClick.HasDelegate ? "av-row-clickable" : null)"
                                tabindex="@(OnRowClick.HasDelegate ? "0" : null)"
                                @onclick="() => OnRowClickedAsync(item)"
                                @onkeydown="e => OnRowKeyDownAsync(e, item)">@RowTemplate?.Invoke(item)</tr>
                        }
                    </tbody>
                </MudSimpleTable>
                break;
        }
    }

    @* Der Sentinel bleibt immer im DOM, damit der IntersectionObserver dasselbe Element beobachten kann. *@
    <div @ref="_sentinel" class="av-infinite-footer" role="status">
        @if (_isLoading || (_rows.Count == 0 && _hasMore && _error is null))
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" aria-label="@L["Infinite.LoadingMore"]" />
        }
        else if (_error is not null && _rows.Count > 0)
        {
            <MudText Class="mud-text-secondary">@ErrorText</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="RetryAsync">@L["State.Retry"]</MudButton>
        }
    </div>
</div>
