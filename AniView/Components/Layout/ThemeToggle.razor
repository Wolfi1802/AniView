<MudTooltip Text="@Label">
    <MudIconButton Icon="@Icon"
                   Color="Color.Inherit"
                   AriaLabel="@Label"
                   OnClick="ToggleAsync" />
</MudTooltip>

@code {
    [Parameter]
    public bool IsDarkMode { get; set; }

    [Parameter]
    public EventCallback<bool> IsDarkModeChanged { get; set; }

    private string Icon => IsDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode;

    private string Label => IsDarkMode ? L["Theme.ToLight"] : L["Theme.ToDark"];

    private Task ToggleAsync() => IsDarkModeChanged.InvokeAsync(!IsDarkMode);
}
