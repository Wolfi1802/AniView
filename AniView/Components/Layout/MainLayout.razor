<MudThemeProvider @ref="_themeProvider"
                  Theme="AniViewTheme.Default"
                  @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="border-b">
        <MudLink Href="/" Underline="Underline.None" Color="Color.Inherit" Typo="Typo.h6" aria-label="AniView – zur Startseite">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Movie" Color="Color.Primary" />
                <span>AniView</span>
            </MudStack>
        </MudLink>
        <MudSpacer />
        <ThemeToggle IsDarkMode="_isDarkMode" IsDarkModeChanged="OnDarkModeChangedAsync" />
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="pt-6 pb-12">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Es ist ein unerwarteter Fehler aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>
